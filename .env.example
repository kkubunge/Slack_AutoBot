# Slack 앱 인증 토큰 (slack_app_manifest.yaml 기반으로 앱 생성 후 발급)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# 접근 제어 (보안을 위해 Slack User ID 등록 필수, 쉼표로 여러 명 구분)
# 비어 있고 ALLOW_ALL_USERS=false 이면 명령 실행을 차단하고 요청자의 User ID를 안내합니다.
ALLOWED_USER_IDS=
ALLOW_ALL_USERS=false

# 허용 채널 ID (비어 있으면 DM 및 봇이 초대된 모든 채널 허용)
ALLOWED_CHANNEL_IDS=

# 봇 시작 알림 및 내장 예약 실행 결과를 보고할 기본 채널 ID
REPORT_CHANNEL_ID=

# 기본 AI 및 프로젝트 설정
DEFAULT_PROJECT=slack_aibot
DEFAULT_MODEL=gemini-4-neon-high
DEFAULT_MODE=dev

# Antigravity CLI 경로 (비어 있으면 PATH 또는 %LOCALAPPDATA%\agy\bin\agy.exe 자동 탐지)
AGY_CLI_PATH=

# 작업 타임아웃(초)
AGY_TIMEOUT_SEC=1800
TASK_TIMEOUT_SEC=1800

# 봇이 시작한 스레드 답글 자동 응답 여부 (true/false)
AUTO_REPLY_THREADS=true
